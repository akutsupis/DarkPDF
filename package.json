{
	"name": "darkpdf",
	"version": "v3.1.0",
	"description": "Dark Mode for PDFs",
	"main": "out/main/app.js",
	"packageManager": "yarn@4.1.1",
	"repository": "https://github.com/akutsupis/DarkPDF",
	"homepage": "https://github.com/akutsupis/DarkPDF#readme",
	"bugs": {
		"url": "https://github.com/akutsupis/DarkPDF/issues"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "rimraf out && tsx ./build.mts",
		"dev": "yarn typecheck && yarn build && DEBUG=1 electron .",
		"dist": "NODE_ENV='production' NODE_OPTIONS='--max-old-space-size=4096' yarn build && NODE_ENV='production' NODE_OPTIONS='--max-old-space-size=4096' electron-builder --config electron-builder-config.js",
		"lint": "biome check .",
		"format": "biome format . --write",
		"ci": "biome ci .",
		"pre-commit": "yarn ci",
		"postinstall": "husky install",
		"prepack": "pinst --disable",
		"postpack": "pinst --enable"
	},
	"author": {
		"name": "Akutsupis"
	},
	"license": "GPL-2.0-only",
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@electron/fuses": "^2.1.1",
		"@types/copy": "^0.3.5",
		"@types/figlet": "^1.7.0",
		"@types/node": "^25.9.0",
		"@types/yargs": "^17.0.35",
		"chalk": "^5.6.2",
		"copy": "^0.3.2",
		"cssnano": "^8.0.1",
		"cssnano-preset-advanced": "^8.0.1",
		"electron": "^42.1.0",
		"electron-builder": "^26.8.1",
		"esbuild": "^0.28.0",
		"esbuild-plugin-glob": "^2.2.3",
		"figlet": "^1.11.0",
		"husky": "^9.1.7",
		"pinst": "^3.0.0",
		"postcss": "^8.5.15",
		"rimraf": "^6.1.3",
		"sass": "^1.99.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"electron-log": "^5.4.4",
		"electron-store": "^11.0.2",
		"electron-tabs": "^1.0.4",
		"electron-updater": "6.8.3",
		"json-schema-typed": "8.0.2",
		"nouislider": "^15.8.1",
		"yargs": "^18.0.0"
	}
}
