{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"includes": ["**", "!app/libs", "!out", "!electron-builder-config.js"]
	},
	"files": {
		"includes": ["**", "!app/libs", "!out", "!electron-builder-config.js"]
	}
}
